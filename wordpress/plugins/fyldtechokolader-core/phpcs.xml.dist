<?xml version="1.0"?>
<ruleset name="Fyldtechokolader Core">
	<description>WordPress coding standards for the project plugin.</description>
	<file>fyldtechokolader-core.php</file>
	<file>src</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<rule ref="WordPress-Core">
		<!-- The plugin uses a namespaced PSR-4 directory layout. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
	</rule>
	<config name="minimum_supported_wp_version" value="6.7" />
	<config name="testVersion" value="8.1-" />
</ruleset>
